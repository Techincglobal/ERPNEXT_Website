---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import CustomerList from "../components/CustomerList";

const testimonials = [
  {
    quote:
      "Moving to NXTGEN was the best decision we made. It completely streamlined our manufacturing process and gave us visibility we never had before.",
    author: "Robert Fox",
    role: "COO, Apex Manufacturing",
    image: "https://i.pravatar.cc/150?u=a042581f4e29026704d",
  },
  {
    quote:
      "The interface is so intuitive that our training time dropped by 60%. The team actually loves using the ERP now.",
    author: "Leslie Alexander",
    role: "VP of Operations, RetailGiant",
    image: "https://i.pravatar.cc/150?u=a042581f4e29026024d",
  },
  {
    quote:
      "The cloud scalability means we never have to worry about infrastructure. We just doubled in size and the system didn't blink.",
    author: "Jenny Wilson",
    role: "CTO, TechFlow",
    image: "https://i.pravatar.cc/150?u=a042581f4e29026704f",
  },
];
---

<Layout>
  <Navbar />
  <main class="relative overflow-hidden bg-slate-50/50">
    <!-- Animated Background Elements -->
    <div
      class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
      <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-100/50 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-100/50 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"
      >
      </div>
    </div>

    <PageHeader
      title="Success"
      highlight="Stories"
      subtitle="See how leading organizations are transforming their operations with NXTGEN."
    />

    <section class="relative z-10 py-12">
      <CustomerList client:load />
    </section>

    <!-- Testimonials -->
    <section class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">
            Trusted by Industry Leaders
          </h2>
          <p class="text-slate-600 max-w-2xl mx-auto">
            Don't just take our word for it. Hear from the people who use our
            platform every day.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {
            testimonials.map((t, i) => (
              <div class="bg-white p-8 rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 flex flex-col hover:-translate-y-1 transition-transform duration-300">
                <div class="mb-6">
                  <div class="flex gap-1 mb-4">
                    {[1, 2, 3, 4, 5].map((star) => (
                      <svg
                        class="w-5 h-5 text-amber-400 fill-current"
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                  <blockquote class="text-slate-700 leading-relaxed font-medium">
                    "{t.quote}"
                  </blockquote>
                </div>
                <div class="mt-auto flex items-center gap-4 pt-6 border-t border-slate-100">
                  <img
                    src={t.image}
                    alt={t.author}
                    class="w-12 h-12 rounded-full border-2 border-white shadow-md"
                  />
                  <div>
                    <div class="font-bold text-slate-900">{t.author}</div>
                    <div class="text-xs text-blue-600 font-bold uppercase tracking-wide">
                      {t.role}
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
