---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout>
  <Navbar />
  <main class="relative overflow-hidden bg-slate-50/50">
    <!-- Animated Background Elements -->
    <div
      class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
      <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-100/50 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-100/50 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"
      >
      </div>
    </div>

    <PageHeader
      title="Grow With"
      highlight="Us"
      subtitle="Partner with NXTGEN to deliver world-class ERP solutions to your clients and unlock new revenue streams."
    />

    <section class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-20">
          <h2 class="text-4xl font-bold text-slate-900 mb-6">
            World-Class Partners
          </h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">
            We collaborate with technology leaders to deliver the best
            solutions.
          </p>
        </div>

        <div class="space-y-12">
          <!-- Frappe -->
          <div
            class="group relative bg-white p-8 md:p-12 rounded-[2rem] shadow-xl shadow-slate-200/50 border border-slate-100 hover:shadow-2xl hover:shadow-blue-900/5 transition-all duration-500 overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 w-[300px] h-[300px] bg-blue-50/50 rounded-full blur-[80px] group-hover:bg-blue-100/50 transition-colors"
            >
            </div>
            <div class="relative flex flex-col md:flex-row gap-12 items-center">
              <div class="w-full md:w-1/3 flex justify-center">
                <div
                  class="w-48 h-32 bg-white rounded-2xl shadow-sm flex items-center justify-center border border-slate-100 group-hover:scale-105 transition-transform duration-300"
                >
                  <div class="text-4xl font-bold text-[#0089FF] tracking-tight">
                    Frappe
                  </div>
                </div>
              </div>
              <div class="w-full md:w-2/3">
                <div class="flex items-center gap-4 mb-4">
                  <h3 class="text-2xl font-bold text-slate-900">
                    Frappe Technologies
                  </h3>
                  <span
                    class="px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold uppercase tracking-wide rounded-full border border-blue-100"
                    >Verified</span
                  >
                </div>
                <p class="text-lg text-slate-600 leading-relaxed mb-6">
                  Frappe Technologies, based in Mumbai, India, is the creator of
                  the Frappe Framework, a low-code platform, with a multitude of
                  applications called Frappe Apps. Founded in 2008, Frappe
                  focuses on building transparent, community-driven, and
                  scalable solutions.
                </p>
                <div
                  class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-50 to-indigo-50 text-blue-700 text-sm font-bold rounded-xl border border-blue-100 shadow-sm"
                >
                  <span
                    class="w-2 h-2 rounded-full bg-blue-500 mr-2 animate-pulse"
                  ></span>
                  Certified Authorized Partner
                </div>
              </div>
            </div>
          </div>

          <!-- Orel Cloud -->
          <div
            class="group relative bg-white p-8 md:p-12 rounded-[2rem] shadow-xl shadow-slate-200/50 border border-slate-100 hover:shadow-2xl hover:shadow-red-900/5 transition-all duration-500 overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 w-[300px] h-[300px] bg-red-50/50 rounded-full blur-[80px] group-hover:bg-red-100/50 transition-colors"
            >
            </div>
            <div class="relative flex flex-col md:flex-row gap-12 items-center">
              <div class="w-full md:w-1/3 flex justify-center">
                <div
                  class="w-48 h-32 bg-white rounded-2xl shadow-sm flex flex-col items-center justify-center border border-slate-100 group-hover:scale-105 transition-transform duration-300"
                >
                  <span class="text-4xl font-bold text-[#ED1C24] tracking-wide"
                    >OREL</span
                  >
                  <span
                    class="text-sm font-bold text-[#ED1C24] tracking-[0.2em] uppercase mt-1"
                    >Cloud</span
                  >
                </div>
              </div>
              <div class="w-full md:w-2/3">
                <div class="flex items-center gap-4 mb-4">
                  <h3 class="text-2xl font-bold text-slate-900">Orel Cloud</h3>
                  <span
                    class="px-3 py-1 bg-red-50 text-red-700 text-xs font-bold uppercase tracking-wide rounded-full border border-red-100"
                    >Verified</span
                  >
                </div>
                <p class="text-lg text-slate-600 leading-relaxed mb-6">
                  Orel IT, headquartered in Sri Lanka, is a global technology
                  company specializing in artificial intelligence, cloud
                  services, data science, and cybersecurity. As the largest IT
                  employer in Sri Lanka, Orel IT focuses on leveraging
                  technology to empower humanity.
                </p>
                <div class="flex flex-wrap gap-3">
                  {
                    ["SKYE", "SDP", "Reseller"].map((tag) => (
                      <span class="px-4 py-2 bg-red-50 text-red-700 text-sm font-bold rounded-xl border border-red-100 hover:bg-red-100 transition-colors cursor-default">
                        {tag}
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- SEBSA -->
          <div
            class="group relative bg-white p-8 md:p-12 rounded-[2rem] shadow-xl shadow-slate-200/50 border border-slate-100 hover:shadow-2xl hover:shadow-purple-900/5 transition-all duration-500 overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 w-[300px] h-[300px] bg-purple-50/50 rounded-full blur-[80px] group-hover:bg-purple-100/50 transition-colors"
            >
            </div>
            <div class="relative flex flex-col md:flex-row gap-12 items-center">
              <div class="w-full md:w-1/3 flex justify-center">
                <div
                  class="w-48 h-32 bg-white rounded-2xl shadow-sm flex items-center justify-center border border-slate-100 group-hover:scale-105 transition-transform duration-300"
                >
                  <div
                    class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 tracking-wider"
                  >
                    SEBSA
                  </div>
                </div>
              </div>
              <div class="w-full md:w-2/3">
                <div class="flex items-center gap-4 mb-4">
                  <h3 class="text-2xl font-bold text-slate-900">SEBSA</h3>
                </div>
                <p class="text-lg text-slate-600 leading-relaxed mb-6">
                  SEBSA, established in 2018, is a high-performance
                  techno-functional organization specializing in IFS ERP
                  implementations, upgrades, and support services for businesses
                  worldwide. With operations in Sri Lanka, Sweden, and Romania.
                </p>
                <div
                  class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-purple-50 to-pink-50 text-purple-700 text-sm font-bold rounded-xl border border-purple-100 shadow-sm"
                >
                  Solutions Partner
                </div>
              </div>
            </div>
          </div>

          <!-- EmpowerX -->
          <div
            class="group relative bg-white p-8 md:p-12 rounded-[2rem] shadow-xl shadow-slate-200/50 border border-slate-100 hover:shadow-2xl hover:shadow-orange-900/5 transition-all duration-500 overflow-hidden"
          >
            <div
              class="absolute top-0 right-0 w-[300px] h-[300px] bg-orange-50/50 rounded-full blur-[80px] group-hover:bg-orange-100/50 transition-colors"
            >
            </div>
            <div class="relative flex flex-col md:flex-row gap-12 items-center">
              <div class="w-full md:w-1/3 flex justify-center">
                <div
                  class="w-48 h-32 bg-white rounded-2xl shadow-sm flex items-center justify-center border border-slate-100 group-hover:scale-105 transition-transform duration-300"
                >
                  <div
                    class="w-16 h-16 bg-gradient-to-br from-orange-400 to-orange-600 rounded-tr-[2rem] rounded-bl-[2rem] flex items-center justify-center text-white shadow-lg"
                  >
                    <svg
                      class="w-8 h-8"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"
                      ></path><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"
                      ></path></svg
                    >
                  </div>
                </div>
              </div>
              <div class="w-full md:w-2/3">
                <div class="flex items-center gap-4 mb-4">
                  <h3 class="text-2xl font-bold text-slate-900">
                    EmpowerX Consulting
                  </h3>
                </div>
                <p class="text-lg text-slate-600 leading-relaxed mb-6">
                  EmpowerX Consulting is an innovative strategic advisory firm
                  dedicated to empowering organizations to achieve excellence
                  and navigate transformative change. We specialize in assisting
                  companies with technology adoption.
                </p>
                <div
                  class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-orange-50 to-yellow-50 text-orange-700 text-sm font-bold rounded-xl border border-orange-100 shadow-sm"
                >
                  Strategic Partner
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- CTA Box -->
        <div
          class="mt-32 relative rounded-[2.5rem] p-10 md:p-20 text-center overflow-hidden"
        >
          <div class="absolute inset-0 bg-slate-900"></div>
          <div
            class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-600/30 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"
          >
          </div>
          <div
            class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-600/30 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"
          >
          </div>

          <div class="relative z-10">
            <h2
              class="text-3xl md:text-5xl font-bold mb-8 text-white tracking-tight"
            >
              Ready to become a partner?
            </h2>
            <p
              class="text-slate-300 text-xl max-w-2xl mx-auto mb-10 leading-relaxed"
            >
              Join our ecosystem and start transforming businesses together.
              Apply now to get access to our partner portal and resources.
            </p>
            <a
              href="/contact"
              class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-lg font-bold rounded-xl shadow-xl shadow-blue-900/20 transition-all hover:scale-105 hover:shadow-2xl hover:shadow-blue-900/30 group"
            >
              Apply for Partnership
              <svg
                class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
