---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Layout>
  <Navbar />
  <main>
    <PageHeader 
      title="Grow With" 
      highlight="Us"
      subtitle="Partner with NXTGEN to deliver world-class ERP solutions to your clients and unlock new revenue streams."
    />

<section class="py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Meet Our Partners</h2>
          <p class="text-slate-600">We collaborate with world-class technology leaders to deliver the best solutions.</p>
        </div>

        <div class="space-y-20">
          <!-- Frappe -->
          <div class="flex flex-col md:flex-row gap-12 items-center">
            <div class="w-full md:w-1/3 flex justify-center">
               <!-- Frappe Logo Placeholder -->
               <div class="text-4xl font-bold text-[#0089FF] tracking-tight">Frappe</div>
            </div>
            <div class="w-full md:w-2/3">
              <h3 class="text-xl font-bold text-slate-900 mb-3">Frappe Technologies</h3>
              <p class="text-slate-600 leading-relaxed mb-4">
                Frappe Technologies, based in Mumbai, India, is the creator of the Frappe Framework, a low-code platform, with a multitude of applications called Frappe Apps. Founded in 2008, Frappe focuses on building transparent, community-driven, and scalable solutions.
              </p>
              <div class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-sm font-semibold rounded-full border border-blue-100">
                Certified Authorized Partner
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-slate-100"></div>

          <!-- Orel Cloud -->
          <div class="flex flex-col md:flex-row gap-12 items-center">
            <div class="w-full md:w-1/3 flex justify-center">
               <!-- Orel Logo Placeholder -->
               <div class="flex flex-col items-center">
                  <span class="text-4xl font-bold text-[#ED1C24] tracking-wide">OREL</span>
                  <span class="text-sm font-bold text-[#ED1C24] tracking-[0.2em] uppercase">Cloud</span>
               </div>
            </div>
            <div class="w-full md:w-2/3">
              <h3 class="text-xl font-bold text-slate-900 mb-3">Orel Cloud</h3>
              <p class="text-slate-600 leading-relaxed mb-4">
                Orel IT, headquartered in Sri Lanka, is a global technology company specializing in artificial intelligence, cloud services, data science, and cybersecurity. As the largest IT employer in Sri Lanka, Orel IT focuses on leveraging technology to empower humanity.
              </p>
              <div class="flex flex-wrap gap-2">
                 <span class="px-3 py-1 bg-red-50 text-red-700 text-sm font-semibold rounded-full border border-red-100">SKYE</span>
                 <span class="px-3 py-1 bg-red-50 text-red-700 text-sm font-semibold rounded-full border border-red-100">SDP</span>
                 <span class="px-3 py-1 bg-red-50 text-red-700 text-sm font-semibold rounded-full border border-red-100">Reseller</span>
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-slate-100"></div>

          <!-- SEBSA -->
          <div class="flex flex-col md:flex-row gap-12 items-center">
            <div class="w-full md:w-1/3 flex justify-center">
                <!-- SEBSA Logo Placeholder -->
               <div class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 tracking-wider">
                  SEBSA
               </div>
            </div>
            <div class="w-full md:w-2/3">
              <h3 class="text-xl font-bold text-slate-900 mb-3">SEBSA</h3>
              <p class="text-slate-600 leading-relaxed mb-4">
                SEBSA, established in 2018, is a high-performance techno-functional organization specializing in IFS ERP implementations, upgrades, and support services for businesses worldwide. With operations in Sri Lanka, Sweden, and Romania, SEBSA emphasizes delivering simple, fast, and accurate enterprise solutions.
              </p>
              <div class="inline-block px-3 py-1 bg-purple-50 text-purple-700 text-sm font-semibold rounded-full border border-purple-100">
                Solutions Partner
              </div>
            </div>
          </div>

          <div class="w-full h-px bg-slate-100"></div>

          <!-- EmpowerX -->
          <div class="flex flex-col md:flex-row gap-12 items-center">
            <div class="w-full md:w-1/3 flex justify-center">
                <!-- EmpowerX Logo Placeholder -->
               <div class="w-16 h-16 bg-orange-500 rounded-tr-[2rem] rounded-bl-[2rem] flex items-center justify-center text-white shadow-lg">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path></svg>
               </div>
            </div>
            <div class="w-full md:w-2/3">
              <h3 class="text-xl font-bold text-slate-900 mb-3">EmpowerX Consulting</h3>
              <p class="text-slate-600 leading-relaxed mb-4">
                EmpowerX Consulting is an innovative strategic advisory firm dedicated to empowering organizations to achieve excellence and navigate transformative change. With a deep understanding of the dynamic business landscape, EmpowerX specializes in assisting companies with technology adoption.
              </p>
              <div class="inline-block px-3 py-1 bg-orange-50 text-orange-700 text-sm font-semibold rounded-full border border-orange-100">
                Strategic Partner
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

        <!-- CTA Box -->
        <div class="bg-slate-900 rounded-3xl p-8 md:p-16 text-center text-white overflow-hidden relative">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600 rounded-full blur-3xl opacity-20 translate-x-1/2 -translate-y-1/2"></div>
          <div class="relative z-10">
             <h2 class="text-3xl font-bold mb-6">Ready to become a partner?</h2>
             <p class="text-slate-300 text-lg max-w-2xl mx-auto mb-8">
               Join our ecosystem and start transforming businesses togather. Apply now to get access to our partner portal.
             </p>
             <a href="/contact" class="inline-block px-8 py-4 bg-blue-600 hover:bg-blue-700 rounded-full font-bold transition-all hover:scale-105">
               Apply for Partnership
             </a>
          </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>
