---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout>
  <Navbar />
  <main class="relative overflow-hidden bg-slate-50/50">
    <!-- Animated Background Elements -->
    <div
      class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
      <div
        class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-100/50 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-100/50 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"
      >
      </div>
    </div>

    <PageHeader
      title="Get in"
      highlight="Touch"
      subtitle="Ready to transform your business? Let's start the conversation about your future."
    />

    <section class="py-20 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Contact Info -->
          <div class="space-y-12">
            <div>
              <h2 class="text-3xl font-bold text-slate-900 mb-6">
                Let's build something great
              </h2>
              <p class="text-lg text-slate-600 leading-relaxed">
                Whether you have a question about features, pricing, need a
                demo, or anything else, our team is ready to answer all your
                questions.
              </p>
            </div>

            <div class="space-y-8">
              <div class="flex items-start gap-6 group">
                <div
                  class="w-14 h-14 rounded-2xl bg-white shadow-lg shadow-blue-900/5 flex items-center justify-center text-blue-600 flex-shrink-0 border border-slate-100 group-hover:scale-110 transition-transform duration-300"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 mb-2">
                    Our Office
                  </h3>
                  <p class="text-slate-600 leading-relaxed">
                    No. 289/7 d, Lake Road,<br />Malabe, Sri Lanka
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-6 group">
                <div
                  class="w-14 h-14 rounded-2xl bg-white shadow-lg shadow-blue-900/5 flex items-center justify-center text-blue-600 flex-shrink-0 border border-slate-100 group-hover:scale-110 transition-transform duration-300"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 mb-2">
                    Email Us
                  </h3>
                  <p class="text-slate-600 mb-2">
                    General: <a
                      href="mailto:info@techincglobal.com"
                      class="text-blue-600 font-medium hover:text-blue-700 underline decoration-blue-600/30 hover:decoration-blue-700 transition-all"
                      >info@techincglobal.com</a
                    >
                  </p>
                </div>
              </div>

              <div class="flex items-start gap-6 group">
                <div
                  class="w-14 h-14 rounded-2xl bg-white shadow-lg shadow-blue-900/5 flex items-center justify-center text-blue-600 flex-shrink-0 border border-slate-100 group-hover:scale-110 transition-transform duration-300"
                >
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 mb-2">Call Us</h3>
                  <p class="text-slate-600 font-medium">+94 707 978 978</p>
                  <p class="text-slate-400 text-sm mt-1">
                    Mon-Fri from 9am to 6pm
                  </p>
                </div>
              </div>
            </div>

            <!-- Map Integration -->
            <div
              class="mt-12 p-2 bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100"
            >
              <div
                class="h-80 w-full rounded-xl overflow-hidden bg-slate-100 relative"
              >
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15843.51862423985!2d79.95759606680456!3d6.904803561343751!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae257608616143d%3A0xc0787e79393a54b!2sLake%20Rd%2C%20Malabe%2C%20Sri%20Lanka!5e0!3m2!1sen!2slk!4v1709825484837!5m2!1sen!2slk"
                  class="absolute inset-0 w-full h-full grayscale-[20%] hover:grayscale-0 transition-all duration-700"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                >
                </iframe>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="relative group mt-8 lg:mt-0">
            <div
              class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[2rem] opacity-20 blur-xl group-hover:opacity-40 transition duration-1000"
            >
            </div>
            <div
              class="relative bg-white p-8 md:p-12 rounded-[1.8rem] shadow-2xl shadow-slate-200/50 border border-slate-100"
            >
              <div class="mb-10">
                <h2 class="text-3xl font-bold text-slate-900 mb-4">
                  Send us a message
                </h2>
                <p class="text-slate-500">
                  We'll get back to you within 24 hours.
                </p>
              </div>

              <form class="space-y-8">
                <div class="grid md:grid-cols-2 gap-8">
                  <div class="group/input">
                    <label
                      class="block text-sm font-semibold text-slate-700 mb-2 ml-1"
                      >First Name</label
                    >
                    <input
                      type="text"
                      class="w-full px-5 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-300"
                      placeholder="John"
                    />
                  </div>
                  <div class="group/input">
                    <label
                      class="block text-sm font-semibold text-slate-700 mb-2 ml-1"
                      >Last Name</label
                    >
                    <input
                      type="text"
                      class="w-full px-5 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-300"
                      placeholder="Doe"
                    />
                  </div>
                </div>

                <div class="group/input">
                  <label
                    class="block text-sm font-semibold text-slate-700 mb-2 ml-1"
                    >Email Address</label
                  >
                  <input
                    type="email"
                    class="w-full px-5 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-300"
                    placeholder="john@company.com"
                  />
                </div>

                <div class="group/input">
                  <label
                    class="block text-sm font-semibold text-slate-700 mb-2 ml-1"
                    >Subject</label
                  >
                  <div class="relative">
                    <select
                      class="w-full px-5 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-300 appearance-none"
                    >
                      <option>Sales Inquiry</option>
                      <option>Technical Support</option>
                      <option>Partnership</option>
                      <option>Other</option>
                    </select>
                    <div
                      class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-slate-500"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 9l-7 7-7-7"></path></svg
                      >
                    </div>
                  </div>
                </div>

                <div class="group/input">
                  <label
                    class="block text-sm font-semibold text-slate-700 mb-2 ml-1"
                    >Message</label
                  >
                  <textarea
                    rows="4"
                    class="w-full px-5 py-4 rounded-xl bg-slate-50 border border-slate-200 focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all duration-300 resize-none"
                    placeholder="How can we help you?"></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full py-5 px-8 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold text-lg shadow-xl shadow-blue-600/20 hover:shadow-2xl hover:shadow-blue-600/30 hover:-translate-y-1 transition-all duration-300"
                >
                  Send Message
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
