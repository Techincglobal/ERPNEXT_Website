---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const modules = [
  {
    title: "Financial Management",
    description: "Gain complete control over your finances with general ledger, accounts payable/receivable, and fixed asset management. Real-time consolidation for multi-entity organizations.",
    features: ["General Ledger", "Multi-currency support", "Tax compliance", "Budgeting & Forecasting"],
    color: "blue"
  },
  {
    title: "Supply Chain Management",
    description: "Optimize your supply chain from procurement to fulfillment. Improve demand forecasting, reduce inventory costs, and enhance supplier collaboration.",
    features: ["Inventory Control", "Purchase Order Management", "Supplier Portal", "Demand Planning"],
    color: "indigo"
  },
  {
    title: "Human Capital Management",
    description: "Attract, retain, and develop top talent. Streamline payroll, benefits administration, and performance management in a single system.",
    features: ["Core HR", "Payroll Processing", "Time & Attendance", "Talent Acquisition"],
    color: "violet"
  },
  {
    title: "Projects & Services",
    description: "Deliver projects on time and within budget. Manage resources, track time and expenses, and automate billing for service-based organizations.",
    features: ["Project Planning", "Resource Scheduling", "Expense Management", "Project Billing"],
    color: "purple"
  }
];
---

<Layout>
  <Navbar />
  <main class="relative overflow-hidden bg-slate-50/50">
  
    <!-- Animated Background Elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-100/50 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-100/50 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"></div>
    </div>

    <PageHeader 
      title="Comprehensive ERP" 
      highlight="Solutions"
      subtitle="A suite of integrated applications to manage your core business processes efficiently."
    />

    <section class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-32">
        {modules.map((module, index) => (
          <div class={`flex flex-col lg:flex-row items-center gap-16 ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
            
            <div class="lg:w-1/2">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-6 bg-white border border-slate-200 text-slate-900 shadow-sm">
                 <span class={`w-2 h-2 rounded-full bg-${module.color}-500`}></span>
                 {module.title} Module
              </div>
              <h2 class="text-4xl font-bold text-slate-900 mb-6 leading-tight">{module.title}</h2>
              <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                {module.description}
              </p>
              
              <ul class="space-y-4 mb-8">
                {module.features.map(feature => (
                  <li class="flex items-center gap-3 text-slate-700 bg-white/50 p-3 rounded-xl border border-slate-100 shadow-sm">
                    <div class={`w-8 h-8 rounded-lg bg-${module.color}-50 flex items-center justify-center text-${module.color}-600`}>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </div>
                    <span class="font-bold">{feature}</span>
                  </li>
                ))}
              </ul>
              
              <a href="#" class="group inline-flex items-center text-slate-900 font-bold hover:text-blue-600 transition-colors">
                 Learn more about {module.title}
                 <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
              </a>
            </div>

            <div class="lg:w-1/2 w-full perspective-1000 group">
              <div class="relative rounded-3xl p-2 bg-gradient-to-br from-white to-slate-50 border border-slate-200 shadow-2xl transition-transform duration-700 group-hover:rotate-y-2 group-hover:rotate-x-2">
                 <div class={`absolute top-0 right-0 w-full h-full bg-${module.color}-500/5 rounded-3xl blur-3xl -z-10`}></div>
                 
                 <div class="bg-slate-900 rounded-2xl overflow-hidden aspect-[4/3] relative">
                    <!-- Glassy overlay -->
                    <div class="absolute inset-0 bg-gradient-to-tr from-slate-800 to-slate-900 opacity-90"></div>
                    
                    <!-- Content Mockup -->
                    <div class="relative h-full flex p-6 gap-4">
                        <div class="w-16 h-full bg-slate-800/50 rounded-xl border border-slate-700/50 hidden sm:block"></div>
                        <div class="flex-1 space-y-4">
                            <div class="flex gap-4">
                                <div class="w-2/3 h-32 bg-slate-800/50 rounded-xl border border-slate-700/50 p-4">
                                    <div class={`w-12 h-12 rounded-lg bg-${module.color}-500/20 mb-4`}></div>
                                    <div class="w-1/2 h-2 bg-slate-700 rounded"></div>
                                </div>
                                <div class="w-1/3 h-32 bg-slate-800/50 rounded-xl border border-slate-700/50"></div>
                            </div>
                            <div class="h-24 bg-slate-800/50 rounded-xl border border-slate-700/50"></div>
                             <div class="flex gap-4">
                                <div class="w-1/2 h-24 bg-slate-800/50 rounded-xl border border-slate-700/50"></div>
                                <div class="w-1/2 h-24 bg-slate-800/50 rounded-xl border border-slate-700/50"></div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Color Glow -->
                    <div class={`absolute -bottom-20 -left-20 w-64 h-64 bg-${module.color}-500 rounded-full blur-[80px] opacity-20`}></div>
                 </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-16 text-center text-white overflow-hidden relative">
              <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600 rounded-full blur-3xl opacity-20 translate-x-1/2 -translate-y-1/2"></div>
              <div class="relative z-10">
                 <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">Need a custom solution?</h2>
                 <p class="text-slate-300 text-lg md:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
                   Every business is unique. Our solutions architects can help design an ERP implementation perfectly suited to your workflow.
                 </p>
                 <a href="/contact" class="inline-flex items-center px-8 py-4 bg-white text-slate-900 rounded-full font-bold text-lg hover:bg-blue-50 transition-all hover:scale-105 shadow-lg">
                   Book a Consultation
                 </a>
              </div>
            </div>
        </div>
    </section>
  </main>
  <Footer />
</Layout>
