---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const modules = [
  {
    title: "Financial Management",
    description: "Gain complete control over your finances with general ledger, accounts payable/receivable, and fixed asset management. Real-time consolidation for multi-entity organizations.",
    features: ["General Ledger", "Multi-currency support", "Tax compliance", "Budgeting & Forecasting"],
    color: "blue"
  },
  {
    title: "Supply Chain Management",
    description: "Optimize your supply chain from procurement to fulfillment. Improve demand forecasting, reduce inventory costs, and enhance supplier collaboration.",
    features: ["Inventory Control", "Purchase Order Management", "Supplier Portal", "Demand Planning"],
    color: "indigo"
  },
  {
    title: "Human Capital Management",
    description: "Attract, retain, and develop top talent. Streamline payroll, benefits administration, and performance management in a single system.",
    features: ["Core HR", "Payroll Processing", "Time & Attendance", "Talent Acquisition"],
    color: "violet"
  },
  {
    title: "Projects & Services",
    description: "Deliver projects on time and within budget. Manage resources, track time and expenses, and automate billing for service-based organizations.",
    features: ["Project Planning", "Resource Scheduling", "Expense Management", "Project Billing"],
    color: "purple"
  }
];
---

<Layout>
  <Navbar />
  <main>
    <PageHeader 
      title="Comprehensive ERP" 
      highlight="Solutions"
      subtitle="A suite of integrated applications to manage your core business processes efficiently."
    />

    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-32">
        {modules.map((module, index) => (
          <div class={`flex flex-col lg:flex-row items-center gap-16 ${index % 2 !== 0 ? 'lg:flex-row-reverse' : ''}`}>
            
            <div class="lg:w-1/2">
              <span class={`inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider mb-6 bg-${module.color}-100 text-${module.color}-700`}>
                {module.title} Module
              </span>
              <h2 class="text-3xl font-bold text-slate-900 mb-6">{module.title}</h2>
              <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                {module.description}
              </p>
              
              <ul class="space-y-4">
                {module.features.map(feature => (
                  <li class="flex items-center gap-3 text-slate-700">
                    <svg class={`w-5 h-5 text-${module.color}-500 flex-shrink-0`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    <span class="font-medium">{feature}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8">
                 <a href="#" class={`text-${module.color}-600 font-semibold hover:text-${module.color}-700 inline-flex items-center gap-1 hover:gap-2 transition-all`}>
                    View Module Details &rarr;
                 </a>
              </div>
            </div>

            <div class="lg:w-1/2 w-full">
              <div class={`rounded-2xl p-8 bg-${module.color}-50 border border-${module.color}-100/50 relative overflow-hidden group`}>
                <div class={`absolute top-0 right-0 w-64 h-64 bg-${module.color}-200/20 rounded-full blur-3xl -mr-16 -mt-16`}></div>
                <div class="aspect-w-4 aspect-h-3 bg-white rounded-lg shadow-lg flex items-center justify-center border border-slate-100 overflow-hidden">
                   <!-- Placeholder UI Mockup -->
                   <div class="w-full h-full bg-slate-50 relative p-4">
                      <div class="w-1/3 h-4 bg-slate-200 rounded mb-4"></div>
                      <div class="space-y-2">
                         {[1,2,3,4].map(() => (
                            <div class="flex gap-2">
                               <div class="w-full h-2 bg-slate-200 rounded"></div>
                               <div class="w-12 h-2 bg-slate-200 rounded"></div>
                            </div>
                         ))}
                      </div>
                      <div class="absolute bottom-4 right-4 text-slate-300">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                      </div>
                   </div>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 bg-blue-600 text-white">
       <div class="max-w-4xl mx-auto px-4 text-center">
          <h2 class="text-3xl font-bold mb-6">Need a custom solution?</h2>
          <p class="text-blue-100 text-lg mb-8">
             Every business is unique. Our solutions architects can help design an ERP implementation perfectly suited to your workflow.
          </p>
          <a href="/contact" class="inline-block px-8 py-4 bg-white text-blue-600 rounded-full font-bold hover:bg-blue-50 transition-colors shadow-lg">
             Book a Free Consultation
          </a>
       </div>
    </section>
  </main>
  <Footer />
</Layout>
