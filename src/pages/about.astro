---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const stats = [
  { label: "Years of Excellence", value: "15+" },
  { label: "Enterprise Clients", value: "500+" },
  { label: "Countries Served", value: "20+" },
  { label: "Team Members", value: "120+" }
];

const team = [
  { name: "Sarah Chen", role: "CEO & Founder", image: "SC" },
  { name: "David Miller", role: "CTO", image: "DM" },
  { name: "Elena Rodriguez", role: "Head of Product", image: "ER" },
  { name: "James Wilson", role: "VP of Sales", image: "JW" }
];
---

<Layout>
  <Navbar />
  <main>
    <PageHeader 
      title="Empowering Business" 
      highlight="Growth"
      subtitle="We are on a mission to simplify enterprise resource planning for the next generation of businesses."
    />

    <!-- Mission Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-bold text-slate-900 mb-6">Our Story</h2>
            <p class="text-lg text-slate-600 mb-6 leading-relaxed">
              Founded in 2010, NXTGEN started with a simple observation: ERP systems were too complex, too expensive, and too rigid for modern agile businesses.
            </p>
            <p class="text-lg text-slate-600 mb-6 leading-relaxed">
              We set out to change that by building a cloud-native platform that combines enterprise-grade power with consumer-grade usability. Today, we help hundreds of organizations across the globe streamline their operations and unlock their true potential.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-4">
             {stats.map(stat => (
               <div class="bg-blue-50 p-8 rounded-2xl text-center">
                 <div class="text-4xl font-bold text-blue-600 mb-2">{stat.value}</div>
                 <div class="text-sm font-semibold text-slate-600 uppercase tracking-wide">{stat.label}</div>
               </div>
             ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold mb-4">Core Values</h2>
          <p class="text-slate-400 max-w-2xl mx-auto">The principles that guide every decision we make.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { title: "Customer Obsession", desc: "We don't just build software; we solve real customer problems." },
            { title: "Simplicity First", desc: "Complexity is easy. Simplicity requires mastery." },
            { title: "Continuous Innovation", desc: "The status quo is our only competitor." }
          ].map(val => (
            <div class="bg-slate-800 p-8 rounded-xl border border-slate-700 hover:border-blue-500 transition-colors">
              <h3 class="text-xl font-bold mb-4">{val.title}</h3>
              <p class="text-slate-400 leading-relaxed">{val.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Leadership Team</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-8">
          {team.map(member => (
            <div class="text-center group">
              <div class="w-40 h-40 mx-auto bg-slate-200 rounded-full mb-6 flex items-center justify-center text-3xl font-bold text-slate-400 group-hover:scale-105 transition-transform duration-300">
                {member.image}
              </div>
              <h3 class="text-xl font-bold text-slate-900">{member.name}</h3>
              <p class="text-blue-600 font-medium">{member.role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
