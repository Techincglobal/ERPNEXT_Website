---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const stats = [
  { label: "Years of Excellence", value: "8+" },
  { label: "Enterprise Clients", value: "20+" },
  { label: "Countries Served", value: "20+" },
  { label: "Team Members", value: "8+" }
];

const team = [
  { name: "Sean Fernando", role: "", image: "SF" },
  { name: "Lahiru Patirana", role: "", image: "LP" },
  { name: "Wasantha Warnasuriya", role: "", image: "WW" }
];
---

<Layout>
  <Navbar />
  <main class="relative overflow-hidden bg-slate-50/50">
    
    <!-- Background Elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-100/50 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/2"></div>
      <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-100/50 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/2"></div>
    </div>

    <PageHeader 
      title="Empowering Business" 
      highlight="Growth"
      subtitle="We are on a mission to simplify enterprise resource planning for the next generation of businesses."
    />

    <!-- Mission Section -->
    <section class="py-24 relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="absolute -inset-4 bg-gradient-to-r from-blue-100 to-indigo-100 rounded-2xl blur-xl opacity-50"></div>
            <div class="relative">
                <h2 class="text-4xl font-bold text-slate-900 mb-8 leading-tight">Driven by a vision of <br/><span class="text-blue-600">limitless potential.</span></h2>
                <p class="text-lg text-slate-600 mb-6 leading-relaxed">
                  Founded in 2010, NXTGEN started with a simple observation: ERP systems were too complex, too expensive, and too rigid for modern agile businesses.
                </p>
                <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                  We set out to change that by building a cloud-native platform that combines enterprise-grade power with consumer-grade usability. Today, we help hundreds of organizations across the globe streamline their operations.
                </p>
                <div class="flex items-center gap-4">
                    <div class="h-1 w-20 bg-blue-600 rounded"></div>
                    <span class="text-sm font-semibold tracking-wider uppercase text-slate-400">Our History</span>
                </div>
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-6">
             {stats.map(stat => (
               <div class="group bg-white p-8 rounded-[1.5rem] shadow-xl shadow-slate-200/50 border border-slate-100 hover:-translate-y-2 transition-all duration-300 relative overflow-hidden">
                 <div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-full -translate-y-1/2 translate-x-1/2 group-hover:bg-blue-100 transition-colors"></div>
                 <div class="relative">
                    <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 mb-2">{stat.value}</div>
                    <div class="text-sm font-bold text-slate-600 uppercase tracking-wide">{stat.label}</div>
                 </div>
               </div>
             ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-32 bg-[#0B1120] text-white relative overflow-hidden">
      <!-- Decor -->
      <div class="absolute top-0 left-1/2 w-full -translate-x-1/2 h-full overflow-hidden pointer-events-none opacity-40">
           <div class="absolute top-[20%] left-[20%] w-[500px] h-[500px] bg-blue-500/20 rounded-full blur-[120px]"></div>
           <div class="absolute bottom-[20%] right-[20%] w-[500px] h-[500px] bg-indigo-500/20 rounded-full blur-[120px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-20">
          <h2 class="text-4xl md:text-5xl font-bold mb-6 tracking-tight">Core Values</h2>
          <p class="text-slate-400 max-w-2xl mx-auto text-lg">The principles that guide every decision we make, from code to customer support.</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { title: "Customer Obsession", desc: "We don't just build software; we solve real customer problems. Your success is our north star." },
            { title: "Simplicity First", desc: "Complexity is easy. Simplicity requires mastery. We strive to make the complex simple." },
            { title: "Continuous Innovation", desc: "The status quo is our only competitor. We are always looking for better ways to serve you." }
          ].map(val => (
            <div class="group p-10 rounded-[2rem] bg-slate-800/50 border border-white/5 hover:bg-slate-800/80 hover:border-blue-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-900/20 backdrop-blur-sm">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center mb-6 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
              </div>
              <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-blue-400 transition-colors">{val.title}</h3>
              <p class="text-slate-400 leading-relaxed group-hover:text-slate-300 transition-colors">{val.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-32 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-20">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">Leadership Team</h2>
          <p class="text-lg text-slate-600">Meet the minds behind the platform.</p>
        </div>
        <div class="grid md:grid-cols-4 gap-10">
          {team.map((member, index) => (
            <div class="group text-center">
              <div class="relative w-48 h-48 mx-auto mb-8">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-full blur opacity-20 group-hover:opacity-40 transition-opacity duration-500"></div>
                <div class={`relative w-full h-full rounded-full flex items-center justify-center text-3xl font-bold text-white shadow-xl overflow-hidden bg-gradient-to-br ${
                    index % 2 === 0 ? 'from-blue-500 to-indigo-600' : 'from-indigo-500 to-purple-600'
                } group-hover:scale-105 transition-transform duration-500`}>
                  {member.image}
                  <!-- Just a decorative sheen -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                </div>
              </div>
              <h3 class="text-xl font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors">{member.name}</h3>
              <p class="text-blue-600 font-medium opacity-80">{member.role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
