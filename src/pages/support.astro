---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main>
    <section class="bg-blue-600 py-20 text-white text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-4 relative z-10">
        <h1 class="text-4xl font-bold mb-6">How can we help you?</h1>
        <div class="max-w-2xl mx-auto relative">
          <input type="text" placeholder="Search for articles, guides, and docs..." class="w-full px-6 py-4 rounded-full text-slate-900 focus:outline-none focus:ring-4 focus:ring-blue-500/30 shadow-xl" />
          <svg class="w-6 h-6 text-slate-400 absolute right-6 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
      </div>
      <!-- Decorative circles -->
      <div class="absolute top-0 left-0 w-64 h-64 bg-blue-500/30 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
      <div class="absolute bottom-0 right-0 w-64 h-64 bg-indigo-500/30 rounded-full blur-3xl translate-x-1/2 translate-y-1/2"></div>
    </section>

    <section class="py-20 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-3 gap-8">
          
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Knowledge Base</h3>
            <p class="text-slate-600 mb-4">Browse detailed guides and tutorials to get the most out of NXTGEN.</p>
            <a href="#" class="text-blue-600 font-semibold hover:underline">View Articles &rarr;</a>
          </div>

          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Community Forum</h3>
            <p class="text-slate-600 mb-4">Join the conversation with other users and share best practices.</p>
            <a href="#" class="text-blue-600 font-semibold hover:underline">Visit Forum &rarr;</a>
          </div>

          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center mb-6">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2">Submit a Ticket</h3>
            <p class="text-slate-600 mb-4">Having an issue? Our support team is ready to assist you 24/7.</p>
            <a href="/contact" class="text-blue-600 font-semibold hover:underline">Contact Support &rarr;</a>
          </div>

        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center mb-12">Frequently Asked Questions</h2>
        <div class="space-y-4">
           {[1, 2, 3, 4].map((i) => (
             <details class="group bg-white rounded-lg border border-slate-200 open:border-blue-200 overflow-hidden transition-all">
               <summary class="flex justify-between items-center p-6 cursor-pointer font-medium text-slate-900 group-hover:bg-slate-50 transition-colors">
                  <span>How do I reset my password? {i}</span>
                  <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
               </summary>
               <div class="px-6 pb-6 text-slate-600 leading-relaxed bg-slate-50/50">
                  To reset your password, click on the "Forgot Password" link on the login page. You will receive an email with instructions to create a new password.
               </div>
             </details>
           ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
