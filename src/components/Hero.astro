---
---
<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-white">
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-[800px] h-[800px] bg-gradient-to-br from-blue-100/40 to-indigo-100/40 rounded-full blur-3xl opacity-70"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/4 -translate-x-1/4 w-[600px] h-[600px] bg-gradient-to-tr from-cyan-100/40 to-blue-100/40 rounded-full blur-3xl opacity-70"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <div class="opacity-0 animate-fade-up">
      <span class="inline-flex items-center gap-2 py-1.5 px-3 rounded-full bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold uppercase tracking-wider mb-8 hover:bg-blue-100 transition-colors cursor-default">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
        </span>
        We Transform Businesses
      </span>
    </div>
    
    <h1 class="opacity-0 animate-fade-up delay-100 text-5xl md:text-7xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1] text-balance">
      ERP MADE <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600">EASY!</span>
    </h1>
    <p class="opacity-0 animate-fade-up delay-150 text-2xl md:text-3xl font-bold text-slate-700 mb-6">
      With Next Generation of Enterprise Applications
    </p>
    
    <p class="opacity-0 animate-fade-up delay-200 mt-4 text-lg text-slate-600 max-w-3xl mx-auto mb-10 text-balance leading-relaxed">
      Implementing NXTGEN ERP is not just a project it’s a transformative experience. From the moment you begin, you’ll feel the ease of integration, the power of automation, and the clarity that comes from having real-time insights at your fingertips.
    </p>
    
    <div class="opacity-0 animate-fade-up delay-300 flex flex-col sm:flex-row justify-center gap-4">
      <a href="/contact" class="px-8 py-4 rounded-full bg-blue-600 text-white text-base font-bold shadow-lg shadow-blue-500/30 hover:shadow-blue-500/40 hover:bg-blue-700 transition-all hover:-translate-y-1 active:translate-y-0">
        Start Free Trial
      </a>
      <a href="#demo" class="px-8 py-4 rounded-full bg-white text-slate-700 border border-slate-200 text-base font-bold hover:border-slate-300 hover:bg-slate-50 transition-all hover:-translate-y-1 active:translate-y-0">
        Watch Demo
      </a>
    </div>
    
    <!-- Hero Image Placeholder -->
    <div class="opacity-0 animate-fade-up delay-300 mt-20 relative mx-auto max-w-5xl perspective-1000">
        <div class="group relative rounded-2xl shadow-2xl overflow-hidden border border-slate-200/60 bg-white transform transition-transform duration-700 hover:rotate-x-1">
            <div class="absolute inset-0 bg-gradient-to-tr from-slate-100 via-white to-slate-50 opacity-50"></div>
            <!-- Mock UI -->
            <div class="aspect-w-16 aspect-h-9 bg-slate-50 p-4 sm:p-8 flex flex-col gap-6">
               <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                  <div class="flex gap-2">
                     <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                     <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                     <div class="w-3 h-3 rounded-full bg-slate-300"></div>
                  </div>
                  <div class="w-1/3 h-2 bg-slate-200 rounded-full"></div>
               </div>
               <div class="flex gap-8 h-full">
                  <div class="w-1/4 h-full bg-white rounded-lg border border-slate-200 p-4 space-y-3 hidden sm:block">
                     <div class="w-3/4 h-3 bg-slate-100 rounded"></div>
                     <div class="w-full h-8 bg-blue-50/50 rounded flex items-center px-2"><div class="w-1/2 h-2 bg-blue-100 rounded"></div></div>
                     {[1,2,3,4].map(i => (
                         <div class="w-full h-8 flex items-center px-2"><div class="w-2/3 h-2 bg-slate-100 rounded"></div></div>
                     ))}
                  </div>
                  <div class="flex-1 h-full space-y-4">
                      <div class="grid grid-cols-3 gap-4">
                          {[1,2,3].map(i => (
                              <div class="h-24 bg-white rounded-xl border border-slate-100 p-4 shadow-sm">
                                  <div class="w-8 h-8 rounded bg-indigo-50 mb-2"></div>
                                  <div class="w-1/2 h-2 bg-slate-100 rounded mb-2"></div>
                                  <div class="w-3/4 h-3 bg-slate-200 rounded"></div>
                              </div>
                          ))}
                      </div>
                      <div class="h-48 bg-white rounded-xl border border-slate-100 shadow-sm p-4">
                        <div class="flex items-end justify-between h-full gap-2 px-2 pb-2">
                           {[40, 60, 45, 70, 50, 80, 65, 85].map(height => (
                             <div class="w-full bg-blue-500/10 rounded-t-sm hover:bg-blue-500/20 transition-colors" style={`height: ${height}%`}></div>
                           ))}
                        </div>
                      </div>
                  </div>
               </div>
            </div>
        </div>
        
        <!-- Floating badge -->
        <div class="absolute -right-4 -bottom-4 lg:-right-8 lg:bottom-12 bg-white/90 backdrop-blur-md p-4 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] border border-white/20 animate-float z-20">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center text-green-600 shadow-inner">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                </div>
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wide">Monthly Growth</p>
                    <p class="text-xl font-bold text-slate-900">+127.4%</p>
                </div>
            </div>
        </div>
    </div>
  </div>
</section>
