---
const steps = [
  { 
    id: '01', 
    title: "Lead to Cash", 
    description: "Optimizes the cycle from lead capture and quoting through to order fulfillment, invoicing, and payment collection. Ensure faster revenue realization and improved customer satisfaction.", 
    color: "text-blue-600", 
    bg: "bg-blue-50",
    image: "/images/lead_to_cash_workflow_diagram.png" 
  },
  { 
    id: '02', 
    title: "Procure to Pay", 
    description: "Streamlines the process from purchase requisitions and supplier selection to goods receipt and final payment. Gain control over spending and build stronger supplier relationships.", 
    color: "text-indigo-600", 
    bg: "bg-indigo-50",
    image: "/images/procure_to_pay_workflow_diagram.png"
  },
  { 
    id: '03', 
    title: "Engineer/Make to Order", 
    description: "Manages ETO processes by linking custom specifications directly to sales orders, coordinating procurement and production. Deliver custom solutions without the operational chaos.", 
    color: "text-sky-600", 
    bg: "bg-sky-50",
    image: "/images/engineer_to_order_workflow_diagram.png"
  },
  { 
    id: '04', 
    title: "Make to Stock", 
    description: "Integrates production planning and inventory levels with demand forecasting to ensure optimal stock availability. Reduce holding costs while preventing stockouts.", 
    color: "text-teal-600", 
    bg: "bg-teal-50",
    image: "/images/make_to_stock_workflow_diagram.png"
  },
  { 
    id: '05', 
    title: "Hire to Retire", 
    description: "An all-in-one solution for the employee lifecycle: recruitment, onboarding, leave, attendance, payroll, and performance. Create a positive employee experience from day one.", 
    color: "text-purple-600", 
    bg: "bg-purple-50",
    image: "/images/hire_to_retire_workflow_diagram.png"
  },
  { 
    id: '06', 
    title: "Acquisition to Disposal", 
    description: "Tracks assets through their entire lifecycle, including usage, depreciation, maintenance, and eventual decommissioning. Maximize the value of your physical assets.", 
    color: "text-rose-600", 
    bg: "bg-rose-50",
    image: "/images/acquisition_to_disposal_workflow_diagram.png"
  },
  { 
    id: '07', 
    title: "Record to Report", 
    description: "Automates financial data collection and consolidation, simplifying journal entries, reconciliations, and financial statement preparation. Close your books faster and with greater accuracy.", 
    color: "text-violet-600", 
    bg: "bg-violet-50",
    image: "/images/record_to_report_workflow_diagram.png"
  },
];
---

<section class="py-12 md:py-24 overflow-hidden relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
     <h2 class="text-2xl md:text-3xl font-bold text-center text-slate-900 mb-12 md:mb-20">End-to-End Workflow Automation</h2>
     
     <div class="space-y-16 lg:space-y-24 relative">
       <!-- Vertical connecting line -->
       <div class="absolute left-4 lg:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-200 via-indigo-200 to-purple-200 hidden lg:block"></div>

       {steps.map((step, index) => (
         <div class={`relative flex flex-col lg:flex-row items-center gap-8 lg:gap-16 ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
           
           <!-- Content -->
           <div class="lg:w-1/2 lg:text-right">
              <div class={`lg:max-w-md ${index % 2 === 1 ? 'lg:ml-0 lg:mr-auto lg:text-left' : 'lg:ml-auto lg:mr-0'}`}>
                <span class={`inline-block text-6xl font-black opacity-10 mb-4 ${step.color}`}>{step.id}</span>
                <h3 class="text-2xl font-bold text-slate-900 mb-4">{step.title}</h3>
                <p class="text-slate-600 text-lg leading-relaxed mb-6">
                  {step.description}
                </p>
                <a href="#" class={`font-semibold inline-flex items-center gap-1 hover:gap-2 transition-all ${step.color}`}>
                  Learn more &rarr;
                </a>
              </div>
           </div>
           
           <!-- Center Dot (Desktop) -->
           <div class="hidden lg:flex absolute left-1/2 -translate-x-1/2  items-center justify-center w-8 h-8 rounded-full bg-white border-4 border-slate-100 shadow-sm z-10 transition-transform hover:scale-125">
              <div class={`w-3 h-3 rounded-full ${step.color.replace('text-', 'bg-')}`}></div>
           </div>

           <!-- Visual -->
           <div class="lg:w-1/2 w-full">
             <div class={`rounded-2xl p-6 ${step.bg} border-2 border-white shadow-xl hover:-translate-y-2 transition-transform duration-500 overflow-hidden group`}>
                <div class="aspect-w-16 aspect-h-9 bg-white rounded-xl flex items-center justify-center border border-white/60 overflow-hidden relative">
                   {/* Background Pattern */}
                   <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"></div>
                   
                   <img 
                      src={step.image} 
                      alt={`${step.title} Workflow Diagram`} 
                      class="w-full h-full object-contain p-4 transition-transform duration-700 group-hover:scale-105"
                   />
                </div>
             </div>
           </div>

         </div>
       ))}
     </div>
  </div>
</section>
