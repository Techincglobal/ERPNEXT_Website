  },
  {
    title: "Real-Time Insights and Reporting",
    description: "Live dashboards for monitoring performance metrics and financials. Get instant visibility into your business health and make faster, informed decisions.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
  },
  {
    title: "Scalability for Growing Businesses",
    description: "Accommodates increasing volumes and users without major upgrades. Whether you're adding new branches or expanding globally, NXTGEN grows with you.",
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
  },
  {
    title: "Customizability for Unique Needs",
    description: "Flexible workflows and modules tailored to specific business requirements. Adapt the system to fit your unique processes rather than changing your business to fit the software.",
